{
  "expo": {
    "name": "lookbook",
    "slug": "lookbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo.png",
    "scheme": "lookbook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ae.lookbook"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.png",
        "backgroundColor": "#C8CECE"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.lookbook"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C8CECE"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ]
      ],
    [
      "expo-font",
      {
        "fonts": [
          "./assets/fonts/InriaSerif-Bold.ttf",
          "./assets/fonts/InriaSerif-BoldItalic.ttf",
          "./assets/fonts/InriaSerif-Italic.ttf",
          "./assets/fonts/InriaSerif-Light.ttf",
          "./assets/fonts/InriaSerif-LightItalic.ttf",
          "./assets/fonts/InriaSerif-Regular.ttf",
          "./assets/fonts/Lora-Bold.ttf",
          "./assets/fonts/Lora-BoldItalic.ttf",
          "./assets/fonts/Lora-Italic.ttf",
          "./assets/fonts/Lora-Medium.ttf",
          "./assets/fonts/Lora-MediumItalic.ttf",
          "./assets/fonts/Lora-Regular.ttf",
          "./assets/fonts/Lora-SemiBold.ttf",
          "./assets/fonts/Lora-SemiBoldItalic.ttf"
      ]
      }
    ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
