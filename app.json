{
  "expo": {
    "name": "Lookbook",
    "slug": "lookbook",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icons/logo.png",
    "scheme": "lookbook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ae.lookbook",
      "deploymentTarget": "17.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.png",
        "backgroundColor": "#C8CECE"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.lookbook"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/logo.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/logo.png",
          "color": "#ffffff",
          "defaultChannel": "default",

          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of your items for your wardrobe"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can add images of you wardrobe.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can add images of your wardrobe."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InriaSerif-Bold.ttf",
            "./assets/fonts/InriaSerif-BoldItalic.ttf",
            "./assets/fonts/InriaSerif-Italic.ttf",
            "./assets/fonts/InriaSerif-Light.ttf",
            "./assets/fonts/InriaSerif-LightItalic.ttf",
            "./assets/fonts/InriaSerif-Regular.ttf",
            "./assets/fonts/Lora-Bold.ttf",
            "./assets/fonts/Lora-BoldItalic.ttf",
            "./assets/fonts/Lora-Italic.ttf",
            "./assets/fonts/Lora-Medium.ttf",
            "./assets/fonts/Lora-MediumItalic.ttf",
            "./assets/fonts/Lora-Regular.ttf",
            "./assets/fonts/Lora-SemiBold.ttf",
            "./assets/fonts/Lora-SemiBoldItalic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a3a6c7e-ddf5-481f-9886-2dfcf8867973"
      }
    }
  }
}
